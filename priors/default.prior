#Make sure your $PYTHONPATH points to where mlow_2_condition can be imported
alpha_1 = Uniform(minimum=-4, maximum=12, name='alpha_1', latex_label='$\\alpha_{1}$')
alpha_2 = Uniform(minimum=-4, maximum=12, name='alpha_2', latex_label='$\\alpha_{2}$')
beta = Uniform(minimum=-2, maximum=7, name='beta1', latex_label='$\\beta_{1,q}$')
mmax = 300
mlow_1 = Uniform(name='mlow_1', minimum=3, maximum=10)
mlow_2 = ConditionalUniform(name='mlow_2', minimum=3, maximum=10, condition_func="lvk_mass_models.mlow_2_condition")
mpp_1 = Uniform(minimum=5, maximum=20, name='mpp_1', latex_label='$\\mu_{m1}$')
mpp_2 = Uniform(minimum=25, maximum=60, name='mpp_2', latex_label='$\\mu_{m2}$')
sigpp_1 = Uniform(minimum=0, maximum=10, name='sigpp_1', latex_label='$\\sigma_{m1}$')
sigpp_2 = Uniform(minimum=0, maximum=10, name='sigpp_2', latex_label='$\\sigma_{m2}$')
delta_m_1 = Uniform(minimum=0, maximum=10, name='delta_m_1', latex_label='$\\delta_{m1}$', boundary='reflective')
delta_m_2 = Uniform(minimum=0, maximum=10, name='delta_m_2', latex_label='$\\delta_{m2}$', boundary='reflective')
lam_0 = DirichletElement(order=0, n_dimensions=3, label='lam_')
lam_1 = DirichletElement(order=1, n_dimensions=3, label='lam_')
mu_chi_eff = Uniform(minimum=-1, maximum=1, name='mu_chi_eff1', latex_label='$\\mu_{\\chi_{eff1}}$')
sigma_chi_eff = Uniform(minimum=0.05, maximum=1.0, name='sigma_chi_eff1', latex_label='$\\sigma_{\\chi_{eff1}}$')
mu_chi_p = Uniform(minimum=0.05, maximum=1, name='mu_chi_p1', latex_label='$\\mu_{\\chi_{p1}}$')
sigma_chi_p = Uniform(minimum=0.05, maximum=1.0, name='sigma_chi_p1', latex_label='$\\sigma_{\\chi_{p1}}$')
lamb = Uniform(minimum=-10, maximum=10, name='lamb', latex_label="$\\lambda_z$")